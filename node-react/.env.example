# ---- Sideline (STX sample app) configuration ------------------------------
# Copy to .env and fill in. `docker compose up` reads this file.
#
# Sideline is a fictional sports app used to demonstrate building on STX. It is
# not a real product or company. It connects to the STX exchange over OAuth: a
# Sideline user signs in (mock), then LINKS their STX account; the app shows a
# Sideline wallet (its own balance) alongside the real STX balance.

# The STX exchange to integrate with: the sandbox host that comes with your
# STX invite.
STX_BASE_URL=https://<your STX sandbox host>

# This app's own public origin, no trailing slash. When set, REDIRECT_URI
# defaults to <PUBLIC_URL>/callback and FRONTEND_URL to PUBLIC_URL, and the
# share card uses it. Moving the app to another host is this one line (plus the
# redirect URI registered on the exchange's OAuth client).
# PUBLIC_URL=https://sideline.example.com

# The exchange as the BROWSER sees it (deposit popup, sport icons). Defaults to
# STX_BASE_URL; set it only when the backend reaches STX on an internal address.
# Sent to the browser at runtime, so no rebuild is needed.
# STX_PUBLIC_URL=https://<your STX sandbox host>

# ---- The app: Sideline (a confidential OAuth client) -----------------------
# Credentials that come with your STX invite. The secret
# stays server-side and is sent to the token endpoint via HTTP Basic
# (client_secret_basic); the browser never sees it.
CLIENT_ID=<issued to you>
CLIENT_SECRET=<issued to you>

# Must EXACTLY match one of the redirect URIs registered for the Sideline client.
# STX exact-matches it (no prefix/wildcard). Points at the backend's /callback.
# Defaults to <PUBLIC_URL>/callback when PUBLIC_URL is set.
REDIRECT_URI=http://localhost:8787/callback

# Sideline branding + starting wallet (the ISV-held balance), in cents.
APP_ID=sideline
APP_NAME=Sideline
APP_TAGLINE=Trade real sports markets, powered by the STX Exchange.
APP_BRAND_COLOR=#3d8bff
APP_WALLET_CENTS=25000

# Where the backend sends the browser after a successful connect.
FRONTEND_URL=http://localhost:5173

# Where the Vite dev server's browser finds the backend (dev only; the built
# app calls it on its own origin). Market data, scores and every STX call go
# through the backend, which mints an app token (client_credentials, scope
# market_data) from CLIENT_ID/CLIENT_SECRET above.
VITE_BACKEND_URL=http://localhost:8787

# ---- Optional overrides ----------------------------------------------------
# Space-delimited scopes requested at /authorize for the Sideline client. These
# are the real STX scope vocabulary; STX narrows them to what the client is
# registered for and what the member consents to. (There is deliberately no
# scope that moves money.)
OAUTH_SCOPES=profile.read balance.read portfolio.read orders.read orders.write

# OAuth + API endpoint paths, if the server routes them differently.
# STX_AUTHORIZE_PATH=/oauth/authorize
# STX_TOKEN_PATH=/oauth/token
# STX_REVOKE_PATH=/oauth/revoke
# Balance snapshot endpoint: /api/v1/account/balance
STX_BALANCE_PATH=/api/v1/account/balance
# STX_ORDERS_PATH=/api/v1/orders
