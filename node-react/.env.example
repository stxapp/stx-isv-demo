# ---- STX ISV demo ("Heater") configuration --------------------------------
# Copy to .env and fill in. `docker compose up` reads this file.
#
# This demo presents as an ISV app called "Heater" that connects to the STX
# exchange over OAuth. A Heater user signs in (mock), then LINKS their STX
# account; the app shows a Heater wallet (its own balance) alongside the real
# STX balance.
#
# The blank values below (STX_BASE_URL, CLIENT_ID, CLIENT_SECRET, and the two
# VITE_STX_HTTP_URL) are shared with you separately. See docs.stxapp.io/isv.

# The STX exchange to integrate with (a reachable STX host).
STX_BASE_URL=

# ---- Heater's confidential OAuth client ------------------------------------
# Credentials issued when the Heater app is registered with STX. The secret
# stays server-side and is sent to the token endpoint via HTTP Basic
# (client_secret_basic); the browser never sees it.
CLIENT_ID=
CLIENT_SECRET=

# Must EXACTLY match one of the redirect URIs registered for the Heater client
# (STX exact-matches it, no prefix or wildcard). Points at the backend /callback.
REDIRECT_URI=http://localhost:8787/callback

# Heater branding + starting wallet (the ISV-held balance), in cents.
APP_ID=heater
APP_NAME=Heater
APP_TAGLINE=Fantasy sports, powered by the STX exchange.
APP_BRAND_COLOR=#ff5a1f
APP_WALLET_CENTS=25000

# Where the backend sends the browser after a successful connect.
FRONTEND_URL=http://localhost:5173

# Browser-side URLs (baked into the frontend). Must be reachable from the host.
# Market data (catalog + live feeds) flows through the backend, which mints an
# app token (client_credentials, scope market_data) from CLIENT_ID/CLIENT_SECRET
# above, so the frontend needs no direct STX URL for it.
VITE_BACKEND_URL=http://localhost:8787
# STX public HTTP base, only for links that open the STX site itself (deposit
# page, "powered by" link). Not used for market data.
VITE_STX_HTTP_URL=

# ---- Optional overrides ----------------------------------------------------
# Space-delimited scopes requested at /authorize. These are the real STX scope
# vocabulary; STX narrows them to what the client is registered for and what the
# member consents to. (There is deliberately no scope that moves money.)
OAUTH_SCOPES=identity balance portfolio history trade

# OAuth + API endpoint paths, if the server routes them differently.
# STX_AUTHORIZE_PATH=/oauth/authorize
# STX_TOKEN_PATH=/oauth/token
# STX_REVOKE_PATH=/oauth/revoke
# Balance snapshot. Real STX endpoint: /api/v1/account/balance
STX_BALANCE_PATH=/api/v1/account/balance
# STX_ORDERS_PATH=/api/v1/orders
