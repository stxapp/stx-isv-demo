# ---- STX demo app configuration -----------------------------------------
# Copy to .env and fill in. `docker compose up` reads this file; when running
# without Docker, copy it to backend/.env as well.
#
# The app this runs (Sideline, Playbook, ...) is fictional: a small sports app
# used to demonstrate building on STX. One setting, LOGIN_MODE, picks how
# people get into it. The README has step-by-step setup for each mode.

# ---- 1. The STX exchange and your STX client (every mode) ------------------

# The STX exchange to integrate with: the sandbox host that comes with your
# STX invite.
STX_BASE_URL=https://<your STX sandbox host>

# Your app's STX client, from your STX invite. The secret stays on the backend
# and is sent to STX's token endpoint over HTTP Basic; the browser never sees it.
CLIENT_ID=<issued to you>
CLIENT_SECRET=<issued to you>

# What the app may do for a member, requested when they link their STX account
# or log in with it. STX narrows these to what your client is registered for
# and what the member allows. No scope moves money.
OAUTH_SCOPES=profile.read balance.read portfolio.read orders.read orders.write

# This app's own public origin, no trailing slash. Unset for local runs. When
# set, every redirect URI below defaults to this origin and FRONTEND_URL to it.
# PUBLIC_URL=https://sideline.example.com

# ---- 2. The login mode ------------------------------------------------------
#   own     the app has its own login, then the user links their STX account
#   stx     people register or log in with their STX account
#   vendor  the app's login is a login service that offers STX as an option
LOGIN_MODE=own

# ---- LOGIN_MODE=own ---------------------------------------------------------
# Which login the app uses: privy or mock. Unset: privy when both Privy keys
# below are set, else mock.
#   mock   no password, no account: a stand-in so the demo runs with nothing
#          but STX credentials.
#   privy  a real login (email, Google, X) from https://privy.io. Privy is only
#          what this demo uses; any login of your own works the same way.
# OWN_LOGIN=mock
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=

# Register this redirect URI on your STX client (exact match, no wildcards).
# Used by `own` and `vendor` modes for "link your STX account".
# Defaults to <PUBLIC_URL>/callback when PUBLIC_URL is set.
REDIRECT_URI=http://localhost:8787/callback

# ---- LOGIN_MODE=stx ---------------------------------------------------------
# Register this redirect URI on your STX client (exact match). Your client
# must also be allowed the `openid` scope; the app adds it to OAUTH_SCOPES.
# Defaults to <PUBLIC_URL>/auth/stx/callback when PUBLIC_URL is set.
# STX_LOGIN_REDIRECT_URI=http://localhost:8787/auth/stx/callback

# ---- LOGIN_MODE=vendor ------------------------------------------------------
# Your login service, as plain OpenID Connect settings. The issuer must serve
# <issuer>/.well-known/openid-configuration. Setting STX up as a login option
# happens in the service's dashboard; see the README.
# VENDOR_NAME=Example Login
# VENDOR_ISSUER=https://<your tenant at the login service>
# VENDOR_CLIENT_ID=
# VENDOR_CLIENT_SECRET=
# Register this redirect URI at the login service.
# Defaults to <PUBLIC_URL>/auth/vendor/callback when PUBLIC_URL is set.
# VENDOR_REDIRECT_URI=http://localhost:8787/auth/vendor/callback
# VENDOR_SCOPES=openid profile email
# Extra query parameters for the service's authorize URL, as a query string,
# e.g. to go straight to the STX option on services that support it.
# VENDOR_AUTHORIZE_PARAMS=connection=stx
# How the secret is sent to the service: client_secret_basic or client_secret_post.
# VENDOR_CLIENT_AUTH=client_secret_basic

# ---- 3. Optional -------------------------------------------------------------

# Encrypt the STX tokens the backend stores (AES-256-GCM). 32 random bytes,
# base64: `openssl rand -base64 32`. Unset: stored as they are (local runs).
# Keep this key: tokens stored under it cannot be read with another one, so
# after a change every member has to link their STX account again.
# TOKEN_ENCRYPTION_KEY=

# Send the session cookie over HTTPS only. Set to true when deployed.
# COOKIE_SECURE=true

# The exchange as the BROWSER sees it (deposit popup, sport icons). Defaults to
# STX_BASE_URL; set it only when the backend reaches STX on an internal address.
# STX_PUBLIC_URL=https://<your STX sandbox host>

# The app's name, look and starting wallet (the app's own demo money), in cents.
# APP_ID picks the logo: sideline and playbook have their own.
APP_ID=sideline
APP_NAME=Sideline
APP_TAGLINE=Trade real sports markets, powered by the STX Exchange.
APP_BRAND_COLOR=#3d8bff
APP_WALLET_CENTS=25000

# Local development: where the backend sends the browser after a trip to STX,
# and where the Vite dev server's browser finds the backend. The built app
# serves both from one origin and needs neither.
FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:8787

# STX endpoint paths, if the server routes them differently.
# STX_AUTHORIZE_PATH=/oauth/authorize
# STX_TOKEN_PATH=/oauth/token
# STX_REVOKE_PATH=/oauth/revoke
# STX_BALANCE_PATH=/api/v1/account/balance
# STX_ORDERS_PATH=/api/v1/orders

# Optional Google Analytics 4 id (G-...). Unset: no analytics code loads.
# With an id, analytics is on by default and the footer has an opt-out switch.
# See "Analytics (optional)" in README.md.
# GA_MEASUREMENT_ID=
# Regions (ISO 3166, comma-separated) where analytics starts denied until the
# visitor allows it, e.g. GB,CA-QC.
# GA_CONSENT_REQUIRED_REGIONS=
# Referrals from these domains (and subdomains) are not counted as a source.
# GA_IGNORE_REFERRER_DOMAINS=
# Hosts for cross-domain measurement.
# GA_LINKED_DOMAINS=
